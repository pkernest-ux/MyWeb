{
  "routes": [
    {
      "route": "/ar-v4-field.html",
      "allowedRoles": ["ar_admin"],
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "route": "/admin-ar-v4.html",
      "allowedRoles": ["ar_admin"],
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "route": "/assets/ar-v4/*",
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "route": "/.local/*",
      "statusCode": 404
    },
    {
      "route": "/test-output/*",
      "statusCode": 404
    },
    {
      "route": "/ar-v3.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/assets/ar-v3/ar-v3-app.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/assets/ar-v3/ar-v3-app.css",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/assets/ar/ar-app.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/assets/ar/ar-app.css",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/admin-dashboard.html",
      "allowedRoles": ["ar_admin"]
    },
    {
      "route": "/admin-ar.html",
      "allowedRoles": ["ar_admin"]
    },
    {
      "route": "/api/save-content",
      "methods": ["POST"],
      "allowedRoles": ["ar_admin"]
    },
    {
      "route": "/api/save-ar-content",
      "methods": ["POST"],
      "allowedRoles": ["ar_admin"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/admin.html",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*.{png,jpg,gif,webp}", "/css/*", "/js/*"]
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Content-Security-Policy": "frame-ancestors 'self'"
  }
}
